# Preferred for deployed environments (Render, etc.) — sends over HTTPS,
# which isn't blocked the way raw SMTP often is on PaaS hosts. Get a free
# key at resend.com; no domain verification needed to send from
# onboarding@resend.dev to any recipient.
RESEND_API_KEY=
# RESEND_FROM=Fireflies <onboarding@resend.dev>

# Used only when RESEND_API_KEY is unset — fine for local dev, but several
# hosts (Render included) silently block outbound SMTP, so don't rely on
# this once deployed.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass

BASE_URL=https://your-ngrok-url.ngrok.io
PORT=3001
